# .env — cron 环境变量（跟脚本同目录）
#
# 不要 commit 到 git！.env 已在 .gitignore
# 部署时手动 cp .env.example .env && chmod 600 .env

# Worker URL（你的 VLESS Worker）
WORKER_URL=https://vless.cf.peeweecap.com

# PUT_TOKEN（32 字节 hex，从 Worker wrangler.toml / CF Dashboard 抄来）
# 跟 Worker Secrets 里的 PUT_TOKEN 是同一个值
PUT_TOKEN=a3f9c2e8b1d4f7a9e6c3b8d2f5a1e4c7b9d3f6a8e2c5b1d4f7a9e6c3b8d2f5a1

# OPERATOR（telecom / unicom）
# install.sh 会自动追加，不需要手填
